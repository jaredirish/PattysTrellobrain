import streamlit as st
import google.generativeai as genai
import os
from io import BytesIO
import pypdf

# --- CONFIGURATION ---
st.set_page_config(page_title="Patty's Marketing Brain", page_icon="🧠", layout="wide")

# --- SIDEBAR: SETUP ---
with st.sidebar:
    st.title("🧠 Knowledge Base")
    st.markdown("Upload your Trello exports, PDFs, and Zoom transcripts here.")
    
    # API Key Input
    api_key = st.text_input("Gemini API Key", type="password", help="Get one at aistudio.google.com (It's free)")
    
    if api_key:
        genai.configure(api_key=api_key)
    
    # File Uploader
    uploaded_files = st.file_uploader(
        "Upload Documents", 
        type=["txt", "pdf", "md", "csv"], 
        accept_multiple_files=True
    )
    
    if st.button("Clear Chat"):
        st.session_state.messages = []

# --- MAIN APP LOGIC ---

# Initialize chat history
if "messages" not in st.session_state:
    st.session_state.messages = []

# Initialize context cache
if "context_text" not in st.session_state:
    st.session_state.context_text = ""

def extract_text_from_pdf(file_bytes):
    """Extracts text from a PDF file using pypdf."""
    try:
        pdf_reader = pypdf.PdfReader(BytesIO(file_bytes))
        text = ""
        for page in pdf_reader.pages:
            text += page.extract_text() + "\n"
        return text
    except Exception as e:
        return f"[Error reading PDF: {e}]"

def process_files(files):
    """Reads and combines text from all uploaded files."""
    combined_text = ""
    for uploaded_file in files:
        file_extension = uploaded_file.name.split('.')[-1].lower()
        file_bytes = uploaded_file.getvalue()
        
        content = ""
        if file_extension == 'pdf':
            content = extract_text_from_pdf(file_bytes)
        else:
            # Assume text/md/csv
            try:
                content = file_bytes.decode("utf-8")
            except:
                content = "[Error decoding text file]"
        
        combined_text += f"\n\n--- DOCUMENT: {uploaded_file.name} ---\n{content}"
        
    return combined_text

# Header
st.header("Ask Your Content Library")
st.caption("Stop searching folders. Just ask.")

# 1. Process Uploads
if uploaded_files and api_key:
    if st.sidebar.button("Index Documents"):
        with st.spinner("Reading your brilliance..."):
            st.session_state.context_text = process_files(uploaded_files)
            st.sidebar.success(f"Indexed {len(uploaded_files)} files! ({len(st.session_state.context_text)} chars)")

# 2. Chat Interface
for message in st.session_state.messages:
    with st.chat_message(message["role"]):
        st.markdown(message["content"])

# 3. Handle User Input
if prompt := st.chat_input("Ex: 'Write a prompt sequence for the webinar based on Veronica's call'"):
    if not api_key:
        st.error("Please enter an API Key in the sidebar.")
        st.stop()
        
    if not st.session_state.context_text:
        st.warning("Please upload and index some documents first!")
        st.stop()

    # User message
    st.session_state.messages.append({"role": "user", "content": prompt})
    with st.chat_message("user"):
        st.markdown(prompt)

    # Generate Response
    with st.chat_message("assistant"):
        with st.spinner("Thinking..."):
            try:
                model = genai.GenerativeModel('gemini-1.5-flash')
                
                # We send the ENTIRE context every time. 
                # This works because Gemini 1.5 Flash has a 1M token window.
                full_prompt = f"""
                You are a Marketing Knowledge Assistant. 
                Answer the user's question based strictly on the provided context below.
                If the answer isn't in the context, say "I don't see that in your uploaded docs."
                
                CONTEXT LIBRARY:
                {st.session_state.context_text}
                
                USER QUESTION:
                {prompt}
                """
                
                response = model.generate_content(full_prompt)
                st.markdown(response.text)
                st.session_state.messages.append({"role": "assistant", "content": response.text})
                
            except Exception as e:
                st.error(f"An error occurred: {e}")

