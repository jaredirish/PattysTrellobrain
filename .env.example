# Gemini API Key (get one at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Trello API Credentials
# Get these at https://trello.com/power-ups/admin
# 1. Click "New" to create a Power-Up
# 2. Generate an API Key
# 3. Then click "Token" link to generate your token
TRELLO_API_KEY=your_trello_api_key_here
TRELLO_TOKEN=your_trello_token_here

# Cast Magic API (for audio/video transcription)
# Contact justin@castmagic.io for developer API access
CASTMAGIC_API_SECRET=your_castmagic_api_secret_here

# Sync Settings (optional)
SYNC_INTERVAL_HOURS=24
